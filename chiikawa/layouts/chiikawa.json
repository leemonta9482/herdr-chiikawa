{
  "id": "root",
  "type": "row",
  "cloned_from": { "name": "main", "version": "0.1.11" },
  "preview": "layouts/chiikawa.png",
  "titlebar": "none",
  "traffic_lights": [12, 16],
  "theme": "chiikawa",
  "colors": {
    "canvas": "#00000000",
    "chrome": "#0e14308c",
    "background": "#0b10261a",
    "surface": "#121a3c99",
    "popover": "#141b3df2",
    "raised": "#1c2550d0",
    "hover": "#a9a6e633",
    "selected": "#a9a6e655",
    "border": "#c9c8ff26",
    "input": "#1c2550b8",
    "foreground": "#eef0ff",
    "muted": "#b3b6d9",
    "dim": "#7c80a8",
    "accent": "#f4dc9a",
    "accent_foreground": "#1a1d3a",
    "selection": "#8f8ce066",
    "ansi8": "#283058"
  },
  "background": { "image": "backgrounds/chiikawa-starry-br.jpg", "fit": "cover" },
  "terminal_opacity": 0.2,
  "terminal_padding": [14, 12],
  "divider": { "width": 1, "color": "border" },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": { "px": 268 },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        { "id": "brand", "type": "block", "size": { "px": 46 }, "window_drag": true,
          "content": { "mod": "workspace-chrome" } },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            { "id": "spaces", "type": "block", "size": { "weight": 1 }, "min": 90, "content": { "mod": "spaces" } },
            { "id": "agents", "type": "block", "size": { "weight": 1 }, "min": 90, "content": { "mod": "agents" } }
          ]
        },
        { "id": "sidebar-footer", "type": "block", "size": { "px": 69 },
          "content": { "mod": "workspace-chrome", "props": { "footer": true } } }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        { "id": "tabs", "type": "block", "size": { "px": 42 }, "window_drag": true,
          "background": "chrome", "content": { "mod": "chiikawa-tabs" } },
        {
          "id": "work-body",
          "type": "row",
          "background": "#00000000",
          "padding": 10,
          "gap": 10,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 10,
                  "radius": 14,
                  "background": "background",
                  "lone": true,
                  "border": { "width": 1, "color": "#c9c8ff1f" },
                  "focus": { "width": 1, "color": "#b4b2f259" },
                  "header": { "content": { "mod": "pane" }, "height": 30, "position": "top", "reveal": "always" }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": { "px": 368 },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    { "id": "files", "type": "block", "content": { "mod": "chiikawa-files" } },
                    { "id": "changes", "type": "block", "content": { "mod": "chiikawa-changes" } },
                    { "id": "github", "type": "block", "content": { "mod": "chiikawa-github" } },
                    { "id": "plugins", "type": "block", "content": { "mod": "chiikawa-plugins" } },
                    { "id": "sessions", "type": "block", "content": { "mod": "chiikawa-sessions" } },
                    { "id": "tasks", "type": "block", "content": { "mod": "chiikawa-tasks" } }
                  ]
                }
              ]
            }
          ]
        },
        { "id": "status", "type": "block", "size": { "px": 28 }, "background": "chrome",
          "content": { "mod": "chiikawa-status" } }
      ]
    }
  ]
}
